import { createHash } from "node:crypto";
import { readFile, writeFile, mkdir } from "node:fs/promises";
import { gzipSync, gunzipSync } from "node:zlib";
import { decodeMaikoDance } from "../src/lib/maikoDance";
import { createMaikoParticleGraph } from "../src/lib/maikoParticleMotion";
import { encodeMaikoParticleGraph, particleChecksum } from "../src/lib/maikoParticleGraphBinary";

const site = new URL("../", import.meta.url);
const metadata = new URL("native/particle-graph/precomputed.json", site);
const moduleFile = new URL("src/lib/maikoParticleGraphAssets.ts", site);
const sha = (bytes: Uint8Array | string) => createHash("sha256").update(bytes).digest("hex");
const arrayBuffer = (bytes: Uint8Array) => new Uint8Array(bytes).buffer;
const counts = [7000, 14000, 40000, 84000];
type Asset = { asset: string; sha256: string; checksum: number; bytes: number; gzipBytes: number };
type Model = { checksum: number; bytes: number; graphs: Record<number, Asset> };
const models: Record<string, Model> = {};
const source = createHash("sha256");
for (const name of ["src/lib/maikoDance.ts", "src/lib/maikoParticleMotion.ts", "src/lib/maikoParticleGraphBinary.ts", "scripts/prepare-particle-data.mts"]) {
  source.update(name + "\0").update((await readFile(new URL(name, site), "utf8")).replace(/\r\n/g, "\n"));
}
const sourceSha256 = source.digest("hex");
const declaration = (value: Record<string, Model>) => `// Generated by scripts/prepare-particle-data.mts --build.\nexport const MAIKO_PARTICLE_GRAPH_ASSETS = ${JSON.stringify(value, null, 2)} as const;\n`;
const inputs: Record<string, string> = {};
for (const intro of ["hiphop", "samba"]) {
  const bytes = await readFile(new URL(`public/models/maiko-${intro}.bin`, site));
  inputs[intro] = sha(bytes);
  const buffer = arrayBuffer(bytes);
  models[intro] = { checksum: particleChecksum(buffer), bytes: bytes.length, graphs: {} };
  if (process.argv.includes("--build")) for (const count of counts) {
    const dance = decodeMaikoDance(buffer, count);
    const graph = Buffer.from(encodeMaikoParticleGraph(createMaikoParticleGraph(dance.data, dance.count)));
    const sha256 = sha(graph);
    const asset = `/particles/maiko-${intro}-${count}-${sha256.slice(0, 16)}.bin`;
    const compressed = gzipSync(graph, { level: 9 });
    await mkdir(new URL("public/particles/", site), { recursive: true });
    await writeFile(new URL(`public${asset}`, site), graph);
    await writeFile(new URL(`public${asset}.gz`, site), compressed);
    models[intro].graphs[count] = { asset, sha256, checksum: particleChecksum(arrayBuffer(graph)), bytes: graph.length, gzipBytes: compressed.length };
  }
}
if (process.argv.includes("--build")) {
  await writeFile(metadata, JSON.stringify({ sourceSha256, inputs, models }, null, 2) + "\n");
  await writeFile(moduleFile, declaration(models));
}
try {
  const saved = JSON.parse(await readFile(metadata, "utf8")) as { sourceSha256: string; inputs: typeof inputs; models: typeof models };
  if (saved.sourceSha256 !== sourceSha256 || JSON.stringify(saved.inputs) !== JSON.stringify(inputs) ||
      (await readFile(moduleFile, "utf8")).replace(/\r\n/g, "\n") !== declaration(saved.models)) throw new Error("Stale particle data");
  for (const intro of Object.keys(models)) {
    const model = saved.models[intro];
    if (model.bytes !== models[intro].bytes || model.checksum !== models[intro].checksum) throw new Error("Stale model identity");
    for (const count of counts) {
      const asset = model.graphs[count];
      if (!/^\/particles\/maiko-(hiphop|samba)-(7000|14000|40000|84000)-[a-f0-9]{16}\.bin$/.test(asset.asset)) throw new Error("Invalid particle asset path");
      const bytes = await readFile(new URL(`public${asset.asset}`, site));
      const compressed = await readFile(new URL(`public${asset.asset}.gz`, site));
      if (bytes.length !== 24 + count * 12 || bytes.length !== asset.bytes || sha(bytes) !== asset.sha256 ||
          particleChecksum(arrayBuffer(bytes)) !== asset.checksum || !asset.asset.includes(asset.sha256.slice(0, 16)) ||
          compressed.length !== asset.gzipBytes || !gunzipSync(compressed).equals(bytes)) throw new Error("Corrupt particle data");
      console.log(`Particle data ${intro}/${count}: ${bytes.length} bytes, gzip ${compressed.length}.`);
    }
  }
} catch (error) {
  throw new Error("Rebuild precomputed particle data with npm run particles:precompute (no Rust required).", { cause: error });
}
