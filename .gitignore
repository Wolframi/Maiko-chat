/tools/
/tmp/
/shots/
build-restart.log
scripts/_deploy-run.ps1

# local test fixtures
/test.png
/test.txt
/test.webm

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
.turn-user
.turn-pass
.livekit-url
.livekit-api-key
.livekit-api-secret
.livekit-server.yaml
data/push.json

# vercel
.vercel

