{
  "name": "maiko-desktop",
  "version": "1.1.27",
  "private": true,
  "description": "Майко — приложение для Windows",
  "author": "Maiko",
  "main": "main.cjs",
  "scripts": {
    "assets": "node ../site/scripts/prepare-dtln.mjs && node prepare-icons.cjs && node prepare-native.cjs && node prepare-assets.cjs",
    "prestart": "npm run assets",
    "start": "electron . --local",
    "prestart:remote": "npm run assets",
    "start:remote": "electron .",
    "prepack": "npm run assets -- --remote",
    "pack": "electron-builder --win --x64 --dir",
    "predist": "npm run assets -- --remote",
    "dist": "electron-builder --win --x64",
    "protect": "node protect-code.cjs",
    "verify:protection": "node verify-protection.cjs",
    "test:protection": "node tests/protection.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node tests/smoke.cjs",
    "test:window-assets": "node tests/window-assets.cjs",
    "test:built-icons": "node tests/built-icons.cjs",
    "test:window-animations": "node prepare-native.cjs && node tests/window-animations.cjs",
    "test:viewport": "node tests/viewport.cjs",
    "test:resize": "node tests/window-resize.cjs",
    "test:snap": "node tests/window-snap.cjs",
    "test:compact-members": "node tests/compact-members.cjs",
    "test:local": "node tests/local-start.cjs",
    "test:screen-audio": "node prepare-native.cjs && node tests/screen-audio.cjs",
    "test:capture-cancel": "node tests/capture-cancel.cjs",
    "test:daw-audio": "node prepare-native.cjs && cargo build --manifest-path daw-bridge/Cargo.toml --example test-host --locked --release --target-dir .daw-bridge-build && node tests/daw-audio.cjs",
    "test:persistent-media": "node tests/persistent-media.cjs",
    "verify:release": "node verify-release.cjs",
    "test:updates-ui": "node tests/updates-ui.cjs",
    "test:startup": "node tests/startup.cjs",
    "test:update-handoff": "node tests/update-handoff.cjs",
    "test:site-updates": "node tests/site-updates.cjs",
    "test:downloads": "node tests/downloads.cjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-arrow-functions": "7.29.7",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "javascript-obfuscator": "5.9.0",
    "js-yaml": "4.1.1",
    "parse5": "7.3.0",
    "playwright": "1.62.1",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.7",
    "sharp": "0.34.5"
  },
  "build": {
    "appId": "io.maiko.desktop",
    "productName": "Maiko",
    "beforePack": "./protect-code.cjs",
    "afterPack": "./verify-protection.cjs",
    "afterAllArtifactBuild": "./refresh-built-icons.cjs",
    "extraFiles": [
      {
        "from": "assets/icon.ico",
        "to": "Maiko.ico"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "native/*.exe",
      "native/Maiko DAW Bridge.vst3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": ".protected",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      "native/*.exe",
      "native/*.vst3/**/*",
      "config.json",
      "assets/**/*",
      "bundled-assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Maiko-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Майко",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://maiko.galacticvps.qzz.io/desktop-updates-s3/",
        "useMultipleRangeRequest": false
      }
    ]
  },
  "dependencies": {
    "bytenode": "2.0.0",
    "electron-updater": "6.8.10",
    "socket.io-client": "4.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wolframi/Maiko-chat.git"
  }
}
